{
  "manifest_version": 3,
  "name": "Calm Morning Gateway",
  "short_name": "Calm Gateway",
  "version": "1.3.0",
  "description": "Mindful morning dashboard: Daily Objectives, TODOs, Daily Digest, Weather, RSS, Widget Store, 4-zone layout, and circadian art.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Calm Gateway Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://antigravity.google/*",
    "https://blog.google/*",
    "https://www.blog.google/*",
    "https://deepmind.google/*",
    "https://openai.com/*",
    "https://raw.githubusercontent.com/*",
    "https://www.anthropic.com/*",
    "https://claude.com/*",
    "https://api.daily.dev/*",
    "https://web.dev/*",
    "https://www.smashingmagazine.com/*",
    "https://developer.chrome.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "bookmark-active-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Bookmark active tab to Calm Gateway Reading Queue"
    }
  }
}
